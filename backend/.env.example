# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃에 올라가지 않습니다(.gitignore).
# 같은 키가 여러 번 있으면 마지막 값이 쓰입니다. 바꾼 뒤에는 서버를 재시작하세요.

# --- 사내 AI 채팅 (MonoGPT MonoRouter 기준) ---
# 키는 채팅창·코드·깃헙에 붙여 넣지 마세요.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://monogpt.kr/api/monorouter/v1/anthropic/v1
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
# Anthropic 공식 키(sk-ant-...)를 쓸 때는 위 두 줄을 아래로 바꾸세요.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-sonnet-4-5

# --- FDS 서버 ---
# 화면의 '기록 비우기' 허용(1) / 금지(0). 시연 중에는 1, 실제 운영에서는 0을 권장합니다.
FDS_ALLOW_CLEAR=1
