# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃에 올라가지 않습니다(.gitignore).
# Claude API 키 (https://console.anthropic.com 에서 발급). 채팅창·코드에 붙여 넣지 마세요.
ANTHROPIC_API_KEY=
# 기본은 Anthropic 공식 주소입니다. MonoGPT(MonoRouter) 키를 쓸 때는 아래 주소로 바꾸세요.
# ANTHROPIC_BASE_URL=https://monogpt.kr/api/monorouter/v1/anthropic/v1
# 사용할 모델 이름 (MonoGPT는 claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1024
# 운영 서버에서는 기록 비우기를 끄세요
# FDS_ALLOW_CLEAR=0
