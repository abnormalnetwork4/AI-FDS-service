[Unit]
Description=AI-FDS 분석 서버 (out-of-path, 포트 8000)
After=network.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__/backend
# 설정(FDS_ALLOW_CLEAR 등)은 backend/.env에서 읽습니다. 바꾼 뒤: sudo systemctl restart fds
EnvironmentFile=-__APP_DIR__/backend/.env
# 대시보드 실시간 연결(SSE)이 열려 있어도 5초 안에 재시작되도록 graceful 시간을 줄였습니다.
ExecStart=__APP_DIR__/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 5
TimeoutStopSec=15
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
